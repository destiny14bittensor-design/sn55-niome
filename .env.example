AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Host-specific miner deployment values. Keep real credentials and wallet
# files outside this repository.
NIOME_EXTERNAL_IP=
NIOME_WALLET_PATH=/home/administrator/.bittensor/wallets/main
NIOME_TAO1_WALLET=main1
NIOME_TAO1_HOTKEY=tao1
NIOME_TAO2_WALLET=main1
NIOME_TAO2_HOTKEY=tao2
NIOME_WON1_WALLET=main2
NIOME_WON1_HOTKEY=won1
NIOME_WON2_WALLET=main2
NIOME_WON2_HOTKEY=won2

# Optional dashboard/runtime overrides.
NIOME_DASH_PORT=8111
NIOME_DASH_TARGET_RANK=30
NIOME_FLEET_LANES=tao1,tao2,won1,won2
NIOME_ENABLE_SEED_BRIDGES=false
NIOME_ENABLE_LEGACY_SEED_RESEARCH=false
NIOME_SCORE_CALIBRATION_MODEL=artifacts/research/score_calibration.json
